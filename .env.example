# ============================================
# ChapterFlow - Environment Configuration
# ============================================

# Neon PostgreSQL Connection String
DATABASE_URL="postgresql://USER:PASSWORD@ep-your-project.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Backend Server
PORT=5000
NODE_ENV=development

# Authentication
JWT_SECRET="replace-with-a-long-random-secret-key-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# CORS (Frontend URL)
FRONTEND_URL="http://localhost:5173"

# Frontend API URL (used by Vite)
VITE_API_URL="http://localhost:5000/api"
